
# root
http://vacpro.fyi {
    import access_log
    import security_headers
    import rate_limit_strict
    redir http://moxiu.vacpro.fyi{uri}
}

# my website
http://moxiu.vacpro.fyi {
    import access_log
    import security_headers
    import rate_limit_strict

    @verifiedHTTPS {
        remote_ip 10.0.0.1
        header X-Forwarded-Proto https
    }
    header @verifiedHTTPS Strict-Transport-Security "max-age=31536000"

    @insecureOwner {
        path /api/files/*
        not {
            remote_ip 10.0.0.1
            header X-Forwarded-Proto https
        }
    }
    respond @insecureOwner "Owner actions require HTTPS" 403

    request_body /api/files/upload {
        max_size 10GiB
    }

    @chrome {
        method GET HEAD
        path /header.html /footer.html /site.css /header.js /frames.js /page.js /legacy.js /legacy.css /assets/favicon.png /assets/titlebar.png /assets/chrome-stripe.png /assets/navigation/* /assets/buttons/* /assets/fonts/*
    }

    handle @chrome {
        reverse_proxy 172.17.0.1:3003 {
            trusted_proxies 10.0.0.1/32
        }
    }

    @downloads {
        method GET HEAD
        path /files/*
        expression `path_regexp('^/files/.+[.][^/]+$') || query({'download': '1'})`
        not query view=1
        not query sha256=1
    }

    handle @downloads {
        reverse_proxy 172.17.0.1:3003 {
            trusted_proxies 10.0.0.1/32
        }
    }

    handle {
        reverse_proxy 172.17.0.1:3001 {
            trusted_proxies 10.0.0.1/32
        }
    }
}
